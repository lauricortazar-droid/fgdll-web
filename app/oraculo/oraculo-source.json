{"html":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0\">\n<title>El Oráculo · Tarot & Horóscopo</title>\n<style>\n  :root{\n    --bg-deep:#0b0a17;\n    --bg-deep2:#14122a;\n    --gold:#c9a24b;\n    --gold-bright:#e8c874;\n    --cream:#f6f0e2;\n    --ink:#241e33;\n    --violet:#5d4a86;\n    --violet-soft:#8b76b8;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:\n      radial-gradient(ellipse at 20% -10%, #201c3c 0%, transparent 55%),\n      radial-gradient(ellipse at 90% 110%, #1c1636 0%, transparent 50%),\n      linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-deep2) 100%);\n    color:var(--cream);\n    font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    min-height:100vh;\n    padding:0 0 60px;\n    position:relative;\n    overflow-x:hidden;\n  }\n\n  /* subtle starfield, static, no JS cost */\n  .stars{\n    position:fixed; inset:0; z-index:0; pointer-events:none; opacity:.55;\n    background-image:\n      radial-gradient(1px 1px at 10% 20%, #fff, transparent),\n      radial-gradient(1px 1px at 80% 10%, #fff, transparent),\n      radial-gradient(1px 1px at 60% 70%, #fff, transparent),\n      radial-gradient(1px 1px at 30% 80%, #fff, transparent),\n      radial-gradient(1px 1px at 90% 60%, #fff, transparent),\n      radial-gradient(1px 1px at 45% 35%, #fff, transparent),\n      radial-gradient(1px 1px at 15% 55%, #fff, transparent),\n      radial-gradient(1px 1px at 75% 90%, #fff, transparent);\n    background-repeat:no-repeat;\n  }\n\n  header{\n    position:relative; z-index:1;\n    text-align:center;\n    padding:38px 20px 22px;\n  }\n  .eyebrow{\n    letter-spacing:.28em;\n    text-transform:uppercase;\n    font-size:11px;\n    color:var(--violet-soft);\n    margin:0 0 10px;\n  }\n  h1{\n    font-family:Georgia, \"Iowan Old Style\", \"Palatino Linotype\", serif;\n    font-weight:400;\n    font-size:2.1rem;\n    margin:0;\n    color:var(--gold-bright);\n    letter-spacing:.02em;\n  }\n  .sigil{\n    width:64px; height:64px; margin:18px auto 0;\n    border-radius:50%;\n    border:1px solid var(--gold);\n    position:relative;\n    opacity:.8;\n  }\n  .sigil::before, .sigil::after{\n    content:\"\";\n    position:absolute; inset:10px;\n    border-radius:50%;\n    border:1px solid var(--gold);\n  }\n  .sigil::after{ inset:20px; }\n  @media (prefers-reduced-motion: no-preference){\n    .sigil{ animation: spin 40s linear infinite; }\n  }\n  @keyframes spin{ to{ transform:rotate(360deg);} }\n\n  main{\n    position:relative; z-index:1;\n    max-width:640px;\n    margin:0 auto;\n    padding:0 20px;\n  }\n\n  .tabs{\n    display:flex;\n    gap:10px;\n    margin:30px 0 26px;\n  }\n  .tab{\n    flex:1;\n    padding:13px 10px;\n    text-align:center;\n    background:transparent;\n    border:1px solid var(--violet-soft);\n    color:var(--cream);\n    border-radius:10px;\n    font-size:.95rem;\n    letter-spacing:.03em;\n    cursor:pointer;\n    transition:background .2s, border-color .2s, color .2s;\n  }\n  .tab.active{\n    background:linear-gradient(180deg, var(--gold-bright), var(--gold));\n    color:#231a0d;\n    border-color:var(--gold);\n    font-weight:600;\n  }\n\n  .panel{ display:none; }\n  .panel.active{ display:block; }\n\n  label{\n    display:block;\n    font-size:.8rem;\n    color:var(--violet-soft);\n    margin:14px 0 6px;\n    letter-spacing:.03em;\n  }\n  select, input[type=text]{\n    width:100%;\n    padding:12px 14px;\n    background:rgba(255,255,255,.04);\n    border:1px solid rgba(201,162,75,.4);\n    color:var(--cream);\n    border-radius:8px;\n    font-size:1rem;\n  }\n\n  .btn{\n    display:block;\n    width:100%;\n    margin-top:22px;\n    padding:15px;\n    background:linear-gradient(180deg, var(--gold-bright), var(--gold));\n    border:none;\n    border-radius:10px;\n    color:#231a0d;\n    font-size:1rem;\n    font-weight:600;\n    letter-spacing:.03em;\n    cursor:pointer;\n  }\n  .btn:active{ transform:translateY(1px); }\n  .btn.secondary{\n    background:transparent;\n    border:1px solid var(--gold);\n    color:var(--gold-bright);\n    font-weight:500;\n  }\n\n  .cards-drawn{\n    display:flex;\n    gap:10px;\n    justify-content:center;\n    flex-wrap:wrap;\n    margin:22px 0 6px;\n  }\n  .card-chip{\n    width:78px;\n    padding:10px 6px;\n    text-align:center;\n    background:linear-gradient(160deg, #2b2350, #1a1533);\n    border:1px solid var(--gold);\n    border-radius:8px;\n    font-size:.72rem;\n    line-height:1.25;\n    color:var(--gold-bright);\n  }\n  .card-chip .rev{\n    display:block;\n    color:var(--violet-soft);\n    font-size:.65rem;\n    margin-top:3px;\n  }\n\n  .divider{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    margin:26px 0 18px;\n    color:var(--violet-soft);\n  }\n  .divider::before, .divider::after{\n    content:\"\";\n    flex:1;\n    height:1px;\n    background:linear-gradient(90deg, transparent, var(--gold), transparent);\n  }\n  .divider span{ font-size:11px; letter-spacing:.25em; text-transform:uppercase; }\n\n  .reading{\n    background:var(--cream);\n    color:var(--ink);\n    border:1px solid var(--gold);\n    border-radius:18px;\n    padding:30px 26px;\n    font-family:Georgia, \"Iowan Old Style\", serif;\n    font-size:1.06rem;\n    line-height:1.75;\n    text-align:left;\n    box-shadow:0 20px 45px rgba(0,0,0,.35);\n    min-height:120px;\n  }\n  .reading.empty{\n    text-align:center;\n    color:#6b6070;\n    font-family:-apple-system, sans-serif;\n    font-size:.95rem;\n  }\n  .reading p{ margin:0 0 16px; }\n  .reading p:last-child{ margin-bottom:0; }\n\n  .actions{\n    display:flex;\n    gap:10px;\n    margin-top:16px;\n  }\n  .actions .btn{ margin-top:0; }\n\n  footer{\n    text-align:center;\n    font-size:.72rem;\n    color:var(--violet-soft);\n    margin-top:40px;\n    letter-spacing:.03em;\n  }\n\n  .toast{\n    position:fixed;\n    left:50%; bottom:26px;\n    transform:translateX(-50%) translateY(20px);\n    background:var(--gold-bright);\n    color:#231a0d;\n    padding:10px 18px;\n    border-radius:20px;\n    font-size:.85rem;\n    font-weight:600;\n    opacity:0;\n    pointer-events:none;\n    transition:opacity .25s, transform .25s;\n    z-index:5;\n  }\n  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }\n\n  .print-title{ display:none; }\n\n  @media print{\n    body{ background:#fff !important; color:#000; }\n    .stars, header .eyebrow, .sigil, .tabs, footer, .toast,\n    label, select, input, .btn, .divider{ display:none !important; }\n    main{ max-width:100%; padding:0; }\n    .print-title{\n      display:block;\n      font-family:Georgia, serif;\n      font-size:1.5rem;\n      text-align:center;\n      margin:10px 0 20px;\n      color:#000;\n    }\n    .cards-drawn{ margin-bottom:20px; }\n    .card-chip{\n      background:#fff !important;\n      color:#000 !important;\n      border:1px solid #999 !important;\n    }\n    .card-chip .rev{ color:#555 !important; }\n    .reading{\n      box-shadow:none;\n      border:none;\n      padding:0;\n      font-size:1rem;\n    }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"stars\"></div>\n\n<header>\n  <p class=\"eyebrow\">Lecturas largas · sin límites</p>\n  <h1>El Oráculo</h1>\n  <div class=\"sigil\"></div>\n</header>\n\n<main>\n\n  <div class=\"tabs\">\n    <button class=\"tab active\" data-tab=\"tarot\">Tarot</button>\n    <button class=\"tab\" data-tab=\"horoscopo\">Horóscopo</button>\n  </div>\n\n  <!-- ================= TAROT ================= -->\n  <section class=\"panel active\" id=\"panel-tarot\">\n    <label for=\"spread\">Tipo de tirada</label>\n    <select id=\"spread\">\n      <option value=\"1\">Una carta — pregunta directa</option>\n      <option value=\"3\" selected>Tres cartas — pasado, presente, futuro</option>\n      <option value=\"5\">Cinco cartas — lectura amplia</option>\n    </select>\n\n    <button class=\"btn\" id=\"drawBtn\">Tirar las cartas</button>\n\n    <div class=\"print-title\" id=\"printTitleTarot\">El Oráculo · Lectura de Tarot</div>\n\n    <div class=\"cards-drawn\" id=\"cardsDrawn\"></div>\n\n    <div class=\"divider\"><span>Lectura</span></div>\n    <div class=\"reading empty\" id=\"tarotReading\">Aún no has tirado las cartas. Elige una tirada y pulsa «Tirar las cartas».</div>\n\n    <div class=\"actions\">\n      <button class=\"btn secondary\" id=\"copyTarot\">Copiar lectura</button>\n      <button class=\"btn secondary\" id=\"pdfTarot\">Guardar como PDF</button>\n    </div>\n  </section>\n\n  <!-- ================= HOROSCOPO ================= -->\n  <section class=\"panel\" id=\"panel-horoscopo\">\n    <label for=\"nombre\">Tu nombre (opcional)</label>\n    <input type=\"text\" id=\"nombre\" placeholder=\"Ej. Laura\">\n\n    <label for=\"signo\">Tu signo</label>\n    <select id=\"signo\">\n      <option value=\"\">Sorpréndeme</option>\n      <option>Aries</option><option>Tauro</option><option>Géminis</option>\n      <option>Cáncer</option><option>Leo</option><option>Virgo</option>\n      <option>Libra</option><option>Escorpio</option><option>Sagitario</option>\n      <option>Capricornio</option><option>Acuario</option><option>Piscis</option>\n    </select>\n\n    <button class=\"btn\" id=\"horoBtn\">Generar predicción</button>\n\n    <div class=\"print-title\" id=\"printTitleHoro\">El Oráculo · Predicción</div>\n\n    <div class=\"divider\"><span>Predicción</span></div>\n    <div class=\"reading empty\" id=\"horoReading\">Elige tu signo (o deja que el oráculo lo elija) y pulsa «Generar predicción».</div>\n\n    <div class=\"actions\">\n      <button class=\"btn secondary\" id=\"copyHoro\">Copiar predicción</button>\n      <button class=\"btn secondary\" id=\"pdfHoro\">Guardar como PDF</button>\n    </div>\n  </section>\n\n  <footer>Generado localmente en tu dispositivo · nada se envía a ningún servidor</footer>\n</main>\n\n<div class=\"toast\" id=\"toast\">Copiado</div>\n\n<script>\n/* ============================================================\n   UTILIDADES\n   ============================================================ */\nfunction pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }\nfunction pickMany(arr, n){\n  const copy = arr.slice();\n  const out = [];\n  n = Math.min(n, copy.length);\n  for(let i=0;i<n;i++){\n    const idx = Math.floor(Math.random()*copy.length);\n    out.push(copy.splice(idx,1)[0]);\n  }\n  return out;\n}\nfunction shuffle(arr){ return pickMany(arr, arr.length); }\nfunction cap(s){ return s.charAt(0).toUpperCase() + s.slice(1); }\n\nconst SIGNOS = [\"Aries\",\"Tauro\",\"Géminis\",\"Cáncer\",\"Leo\",\"Virgo\",\"Libra\",\"Escorpio\",\"Sagitario\",\"Capricornio\",\"Acuario\",\"Piscis\"];\nconst MESES = [\"enero\",\"febrero\",\"marzo\",\"abril\",\"mayo\",\"junio\",\"julio\",\"agosto\",\"septiembre\",\"octubre\",\"noviembre\",\"diciembre\"];\nconst DIAS = [\"lunes\",\"martes\",\"miércoles\",\"jueves\",\"viernes\",\"sábado\",\"domingo\"];\nconst MOMENTOS = [\"por la mañana\",\"al mediodía\",\"por la tarde\",\"al anochecer\",\"de madrugada\"];\nconst PERSONAS = [\"un vecino\",\"una vecina\",\"un compañero de trabajo\",\"una compañera de trabajo\",\"una amistad cercana\",\"un familiar lejano\",\"alguien de tu pasado\",\"una persona bastante joven de tu entorno\",\"un antiguo amor\",\"una persona que conociste hace poco\"];\nconst LUGARES = [\"cerca de una montaña\",\"junto al mar\",\"en una ciudad grande\",\"en el campo\",\"en un pueblo pequeño\",\"lejos de aquí\",\"en tu mismo barrio\",\"al otro lado de la ciudad\"];\nfunction numeroFecha(){ return Math.floor(Math.random()*28)+1; }\n\n/* ============================================================\n   BANCOS DE FRASES GENERALES (se combinan para alargar el texto)\n   ============================================================ */\nconst B = {\n  situacion:[\n    \"Hay una situación compleja que se ha ido formando poco a poco y que ahora reclama tu atención.\",\n    \"Te han enseñado una cosa y, sin embargo, la realidad que estás viviendo es totalmente diferente.\",\n    \"Te sientes un poco perdido o perdida y no sabes con certeza qué es lo que tienes que hacer.\",\n    \"Aunque no eres capaz de tomar una decisión todavía, sin lugar a duda pronto tendrás que actuar.\",\n    \"Tendrás que rendirte ante la evidencia y aceptar algo que llevas tiempo evitando ver.\",\n    \"Te encuentras en medio de un conflicto que no empezó contigo, pero en el que te ves implicado o implicada.\",\n    \"Se está gestando un cambio silencioso que todavía no puedes nombrar con claridad.\",\n    \"Algo que creías resuelto vuelve a moverse bajo la superficie de tu vida cotidiana.\",\n    \"Una parte de ti ya sabe hacia dónde va esto, aunque el resto todavía se resista a admitirlo.\",\n    \"Hay una tensión de fondo entre lo que se espera de ti y lo que en realidad te pide el cuerpo.\",\n    \"Llevas un tiempo sosteniendo algo que pesa más de lo que aparentas hacia afuera.\",\n    \"Las señales llevan un rato apareciendo; ahora solo falta que decidas mirarlas de frente.\",\n    \"Un asunto que parecía menor está tomando una dimensión que no anticipabas.\",\n    \"Se abre una etapa donde tendrás que reordenar prioridades que llevabas tiempo postergando.\"\n  ],\n  decision:[\n    \"Quieren verte tomar una decisión en medio de una situación conflictiva, y eso te pesa.\",\n    \"Intentan, de forma deliberada, obligarte a elegir entre dos caminos que no querías tener que comparar.\",\n    \"Será tu responsabilidad hacer una elección delicada que otros no se atreven a hacer por ti.\",\n    \"Necesitarás tiempo a solas para meditar sobre lo que realmente deseas y lo que necesitas en la vida.\",\n    \"Un intercambio franco y directo se volverá inevitable con alguien que tiene sentimientos por ti.\",\n    \"Será crucial separar lo profesional de lo personal, porque mezclarlo solo traerá complicaciones.\",\n    \"Tendrás que llegar a un acuerdo mutuo, y para lograrlo convendrá salir del entorno habitual y hablarlo con calma.\",\n    \"El aire libre y la naturaleza te ayudarán a ver con más claridad antes de decidir nada importante.\",\n    \"No hace falta decidirlo todo de una sola vez; el primer paso correcto suele ser el más pequeño.\",\n    \"Alguien insistirá en apurarte, pero la prisa ajena no debería fijar tus propios tiempos.\",\n    \"Convendrá poner por escrito los motivos reales detrás de cada opción antes de inclinarte por una.\",\n    \"Hay una parte de esta elección que ya tomaste hace tiempo; solo falta que la reconozcas en voz alta.\",\n    \"Pedir una segunda opinión, esta vez, no será señal de debilidad sino de sensatez.\"\n  ],\n  amor:[\n    \"En el terreno afectivo, a la persona que amas le costará entender del todo lo que está pasando.\",\n    \"Deberás explicarte con paciencia para restablecer la armonía en tu relación más cercana.\",\n    \"Una persona merece tu amor más que otra, y tarde o temprano tendrás que reconocerlo.\",\n    \"Se advierte una nueva particularidad en tu complicidad o tu intimidad con alguien que ya conoces.\",\n    \"Te diriges hacia una relación más profunda, más intensa y, sin duda, más impulsiva de lo habitual.\",\n    \"Esa persona se desvivirá más por ti y buscará encuentros más regulares o más formales contigo.\",\n    \"Algunos detalles que hasta ahora parecían insignificantes se volverán mucho más reveladores.\",\n    \"No hay duda de que esta persona tendrá pronto sentimientos más profundos y más insistentes hacia ti.\",\n    \"Un viaje o una ausencia pondrá a prueba la confianza dentro de tu vida amorosa.\",\n    \"La comunicación honesta, aunque incómoda al principio, será la que salve el vínculo.\",\n    \"Habrá un gesto pequeño, casi discreto, que dirá más que cualquier declaración larga.\",\n    \"Un malentendido antiguo pide ser aclarado antes de que la relación pueda avanzar de verdad.\",\n    \"Te costará admitir cuánto te importa esta persona, aunque para los demás sea evidente.\",\n    \"La distancia, física o emocional, funcionará más como prueba que como condena para este vínculo.\"\n  ],\n  trabajoViaje:[\n    \"Tendrás que encontrar tu camino en un entorno abarrotado, con un ir y venir constante de gente.\",\n    \"Esto alcanzará tanto a tu vida profesional como a tu vida personal, casi al mismo tiempo.\",\n    \"Te hará falta emprender un viaje importante, probablemente relacionado con el trabajo o los negocios.\",\n    \"Ese viaje despertará ciertos celos o malentendidos que tendrás que aclarar después.\",\n    \"Una conversación pendiente en el trabajo pedirá de ti una prueba de sinceridad.\",\n    \"Parece que estás a punto de vivir un acercamiento inesperado dentro de tu entorno laboral.\",\n    \"Convendrá que mantengas los pies en la tierra durante tus explicaciones y evites enredarte en detalles innecesarios.\",\n    \"Un proyecto que parecía detenido volverá a moverse de forma repentina.\",\n    \"Reconocerán un esfuerzo tuyo que creías que había pasado desapercibido.\",\n    \"Tendrás que aprender a decir que no a una tarea más, aunque te cueste el orgullo.\",\n    \"Una propuesta laboral inesperada te obligará a repensar tus prioridades a mediano plazo.\",\n    \"El desorden actual es temporal: en poco tiempo encontrarás un ritmo más sostenible.\"\n  ],\n  entorno:[\n    \"Un número, una fecha o un nombre concreto tiene, para ti, un significado especial en este momento.\",\n    `Este mensaje está relacionado con ${pick(PERSONAS)} que vive ${pick(LUGARES)}.`,\n    `Esa persona es de signo ${pick(SIGNOS)} y siente una atracción sincera por ti.`,\n    \"Esa persona está pasando por una ruptura o una pérdida emocional y piensa en ti más de lo que imaginas.\",\n    \"Trata de superar un momento difícil y no siempre tiene a quién contarle lo que siente.\",\n    \"Es una persona hipersensible que tiene necesidad de abrirse contigo, aunque le cueste dar el primer paso.\",\n    \"Tiene un secreto que confiarte y, en el fondo, quiere tu ayuda para reconstruir algo en su vida.\",\n    `Todo esto podría concretarse un ${pick(DIAS)} ${pick(MOMENTOS)}, cerca del mes de ${pick(MESES)}.`,\n    \"Hay alguien en tu entorno que ha cambiado de actitud contigo sin que aún sepas bien por qué.\",\n    \"Una llamada, un mensaje o un reencuentro breve traerá noticias que no esperabas.\",\n    \"Una figura mayor de tu familia tiene algo que decirte, aunque le esté costando encontrar el momento.\"\n  ],\n  consejo:[\n    \"Entras en una fase de estabilización y consolidación; ahora no es aconsejable dar pasos precipitados.\",\n    \"Hará falta que tengas paciencia, porque los tiempos de esta situación no dependen solo de ti.\",\n    \"Este período de reflexión te permitirá entender tus verdaderos sentimientos antes de actuar.\",\n    \"Escucha lo que tu cuerpo y tu intuición te están diciendo, aunque la mente insista en lo contrario.\",\n    \"Evita tomar decisiones importantes movido o movida únicamente por el miedo o la urgencia.\",\n    \"Todo lo que necesitas para resolver esto ya está, de alguna forma, dentro de ti.\",\n    \"No fuerces los tiempos: lo que tenga que acomodarse, se acomodará cuando estés listo o lista.\",\n    \"Cuida tu energía; no toda batalla que se te presenta es tuya para pelear.\",\n    \"Confía en que la claridad llegará poco a poco, aunque ahora todo parezca confuso.\",\n    \"Rodéate de quienes de verdad se alegran de tus avances, y aléjate, sin culpa, de quienes no lo hacen.\",\n    \"Permítete equivocarte sin convertir cada error en una sentencia sobre quién eres.\",\n    \"Anota lo que sientes antes de decidir; muchas veces la respuesta ya está en lo que escribes.\",\n    \"Un pequeño ritual de calma antes de dormir te ayudará a procesar lo que está removiéndose.\",\n    \"No todo lo que empieza ahora tiene que resolverse esta misma semana.\"\n  ]\n};\n\nfunction buildLongText(sections){\n  // sections: array of {bank, count}\n  const paragraphs = [];\n  sections.forEach(sec=>{\n    const chosen = pickMany(B[sec.bank], sec.count);\n    paragraphs.push(chosen.join(\" \"));\n  });\n  return paragraphs;\n}\n\n/* ============================================================\n   TAROT — 22 ARCANOS MAYORES\n   ============================================================ */\nconst ARCANOS = [\n  { nombre:\"El Loco\", icono:\"☆\",\n    up:\"un comienzo impulsivo y la necesidad de confiar en lo desconocido\",\n    rev:\"una imprudencia que ya te costó caro alguna vez, o el miedo a dar el primer paso\" },\n  { nombre:\"El Mago\", icono:\"✦\",\n    up:\"el poder de transformar tus propios recursos en resultados concretos\",\n    rev:\"recursos que se dispersan sin lograr resultados, o una manipulación que conviene vigilar\" },\n  { nombre:\"La Sacerdotisa\", icono:\"☾\",\n    up:\"secretos internos que todavía no te atreves a mirar de frente\",\n    rev:\"secretos que salen a la luz antes de tiempo, o una intuición que llevas tiempo ignorando\" },\n  { nombre:\"La Emperatriz\", icono:\"❀\",\n    up:\"una etapa de crecimiento, abundancia y cuidado de ti mismo o ti misma\",\n    rev:\"un descuido de ti mismo o ti misma, o una dependencia que te está agotando\" },\n  { nombre:\"El Emperador\", icono:\"♛\",\n    up:\"la necesidad de poner orden y estructura donde ahora hay caos\",\n    rev:\"un exceso de control, o una autoridad que ya no te representa como antes\" },\n  { nombre:\"El Hierofante\", icono:\"☥\",\n    up:\"una enseñanza o una tradición familiar que conviene revisar con ojos nuevos\",\n    rev:\"una regla o una tradición que ahora te queda pequeña\" },\n  { nombre:\"Los Enamorados\", icono:\"♡\",\n    up:\"una elección entre dos caminos del corazón\",\n    rev:\"un desacuerdo de fondo, o una elección que llevas demasiado tiempo postergando\" },\n  { nombre:\"El Carro\", icono:\"➳\",\n    up:\"avanzar con determinación aunque fuerzas opuestas tiren de ti en direcciones distintas\",\n    rev:\"una pérdida de rumbo, o un esfuerzo que avanza sin una dirección clara\" },\n  { nombre:\"La Justicia\", icono:\"⚖\",\n    up:\"una verdad que saldrá a la luz y pedirá equilibrio\",\n    rev:\"una injusticia sin resolver, o una decisión que evitas por miedo a las consecuencias\" },\n  { nombre:\"El Ermitaño\", icono:\"✧\",\n    up:\"un tiempo de retiro necesario para escuchar tu propia voz\",\n    rev:\"un aislamiento que ya no te hace bien, o la dificultad para pedir ayuda\" },\n  { nombre:\"La Rueda de la Fortuna\", icono:\"☸\",\n    up:\"un giro inesperado del destino que cambiará el rumbo de las cosas\",\n    rev:\"una racha difícil que, en el fondo, te está pidiendo un cambio de actitud\" },\n  { nombre:\"La Fuerza\", icono:\"∞\",\n    up:\"la calma que, con paciencia, doma lo que parecía incontrolable\",\n    rev:\"una duda sobre tu propia capacidad, o un control forzado que agota más de lo que ayuda\" },\n  { nombre:\"El Colgado\", icono:\"↯\",\n    up:\"una pausa forzada que en realidad es una oportunidad de ver las cosas de otra manera\",\n    rev:\"una resistencia a soltar algo que, en el fondo, ya no tiene sentido sostener\" },\n  { nombre:\"La Muerte\", icono:\"🕯\",\n    up:\"un final necesario para que algo nuevo pueda nacer\",\n    rev:\"un cambio que te resistes a aceptar, aunque ya resulta inevitable\" },\n  { nombre:\"La Templanza\", icono:\"⚗\",\n    up:\"la mezcla paciente de opuestos hasta encontrar armonía\",\n    rev:\"un desequilibrio entre lo que das y lo que recibes\" },\n  { nombre:\"El Diablo\", icono:\"⛓\",\n    up:\"un apego o una tentación de la que cuesta soltarse\",\n    rev:\"el primer paso, aún tímido, hacia liberarte de ese apego\" },\n  { nombre:\"La Torre\", icono:\"⚡\",\n    up:\"una ruptura súbita que revela lo que no estaba bien construido\",\n    rev:\"una crisis que se evita en la superficie, pero que sigue creciendo por debajo\" },\n  { nombre:\"La Estrella\", icono:\"✵\",\n    up:\"la esperanza que regresa después de la tormenta\",\n    rev:\"una desilusión pasajera que, sin embargo, no borra la esperanza de fondo\" },\n  { nombre:\"La Luna\", icono:\"☾\",\n    up:\"miedos e ilusiones que confunden lo real con lo imaginado\",\n    rev:\"una niebla que empieza a disiparse, dejando ver una verdad más clara\" },\n  { nombre:\"El Sol\", icono:\"☀\",\n    up:\"la claridad, la alegría y el reconocimiento que se acercan\",\n    rev:\"una alegría todavía discreta, que no siempre te permites mostrar del todo\" },\n  { nombre:\"El Juicio\", icono:\"⚑\",\n    up:\"un llamado a evaluarte a ti mismo o ti misma con honestidad, y a renacer\",\n    rev:\"una autocrítica excesiva que te impide ver tus propios avances\" },\n  { nombre:\"El Mundo\", icono:\"🜃\",\n    up:\"la culminación de un ciclo y la llegada a una nueva etapa\",\n    rev:\"un ciclo que se cierra más despacio de lo que esperabas\" }\n];\n\nlet ultimasCartas = [];\n\nfunction tirarCartas(n){\n  const elegidas = pickMany(ARCANOS, n);\n  ultimasCartas = elegidas.map(c=>{\n    const invertida = Math.random() < 0.35;\n    return { nombre:c.nombre, icono:c.icono, frase: invertida ? c.rev : c.up, invertida };\n  });\n  return ultimasCartas;\n}\n\nfunction renderCardsDrawn(cartas){\n  const cont = document.getElementById(\"cardsDrawn\");\n  cont.innerHTML = \"\";\n  cartas.forEach(c=>{\n    const div = document.createElement(\"div\");\n    div.className = \"card-chip\";\n    div.innerHTML = `<span style=\"font-size:1.1rem\">${c.icono}</span><br>${c.nombre}` +\n      (c.invertida ? '<span class=\"rev\">Invertida</span>' : '<span class=\"rev\">Al derecho</span>');\n    cont.appendChild(div);\n  });\n}\n\nfunction generarLecturaTarot(cartas){\n  const paragraphs = [];\n\n  cartas.forEach((c)=>{\n    const intro = c.invertida\n      ? `La carta de ${c.nombre} aparece invertida en tu tirada, lo que indica que ${c.frase}.`\n      : `La carta de ${c.nombre} aparece en tu lectura y habla de ${c.frase}.`;\n    const extra = pickMany(shuffle([...B.situacion, ...B.decision, ...B.consejo]), 2).join(\" \");\n    paragraphs.push(intro + \" \" + extra);\n  });\n\n  // párrafos intermedios en orden aleatorio para que no toda lectura se sienta igual\n  const intermedios = shuffle([\n    pickMany(B.amor, 3).join(\" \") + \" \" + pick(B.entorno),\n    pickMany(B.trabajoViaje, 3).join(\" \")\n  ]);\n  paragraphs.push(...intermedios);\n\n  // cierre\n  paragraphs.push(\"En conjunto, \" + pickMany(B.consejo, 3).join(\" \"));\n\n  return paragraphs;\n}\n\nfunction pintarLectura(elId, paragraphs){\n  const el = document.getElementById(elId);\n  el.classList.remove(\"empty\");\n  el.innerHTML = paragraphs.map(p=>`<p>${p}</p>`).join(\"\");\n}\n\ndocument.getElementById(\"drawBtn\").addEventListener(\"click\", ()=>{\n  const n = parseInt(document.getElementById(\"spread\").value, 10);\n  const cartas = tirarCartas(n);\n  renderCardsDrawn(cartas);\n  const paragraphs = generarLecturaTarot(cartas);\n  pintarLectura(\"tarotReading\", paragraphs);\n});\n\ndocument.getElementById(\"copyTarot\").addEventListener(\"click\", ()=>{\n  copiarTexto(\"tarotReading\");\n});\n\n/* ============================================================\n   HOROSCOPO\n   ============================================================ */\ndocument.getElementById(\"horoBtn\").addEventListener(\"click\", ()=>{\n  const nombre = document.getElementById(\"nombre\").value.trim();\n  let signo = document.getElementById(\"signo\").value;\n  if(!signo) signo = pick(SIGNOS);\n\n  const saludo = nombre\n    ? `${cap(nombre)}, para ${signo} el oráculo revela lo siguiente.`\n    : `Para ${signo}, el oráculo revela lo siguiente.`;\n\n  const paragraphs = [];\n  paragraphs.push(saludo + \" \" + pickMany(B.situacion, 3).join(\" \"));\n  paragraphs.push(pickMany(B.decision, 3).join(\" \"));\n  paragraphs.push(pickMany(B.amor, 3).join(\" \"));\n  paragraphs.push(pickMany(B.trabajoViaje, 3).join(\" \"));\n  paragraphs.push(pick(B.entorno) + \" \" + pick(B.entorno));\n  paragraphs.push(pickMany(B.consejo, 3).join(\" \"));\n\n  pintarLectura(\"horoReading\", paragraphs);\n});\n\ndocument.getElementById(\"copyHoro\").addEventListener(\"click\", ()=>{\n  copiarTexto(\"horoReading\");\n});\n\n/* ============================================================\n   TABS + COPIAR\n   ============================================================ */\ndocument.querySelectorAll(\".tab\").forEach(tab=>{\n  tab.addEventListener(\"click\", ()=>{\n    document.querySelectorAll(\".tab\").forEach(t=>t.classList.remove(\"active\"));\n    document.querySelectorAll(\".panel\").forEach(p=>p.classList.remove(\"active\"));\n    tab.classList.add(\"active\");\n    document.getElementById(\"panel-\"+tab.dataset.tab).classList.add(\"active\");\n  });\n});\n\nfunction copiarTexto(elId){\n  const el = document.getElementById(elId);\n  const texto = el.innerText.trim();\n  if(!texto || el.classList.contains(\"empty\")) return;\n\n  const finish = ()=>{\n    const toast = document.getElementById(\"toast\");\n    toast.classList.add(\"show\");\n    setTimeout(()=>toast.classList.remove(\"show\"), 1400);\n  };\n\n  if(navigator.clipboard && navigator.clipboard.writeText){\n    navigator.clipboard.writeText(texto).then(finish).catch(()=>{\n      fallbackCopy(texto, finish);\n    });\n  } else {\n    fallbackCopy(texto, finish);\n  }\n}\n\ndocument.getElementById(\"pdfTarot\").addEventListener(\"click\", ()=>{\n  const el = document.getElementById(\"tarotReading\");\n  if(el.classList.contains(\"empty\")){ return; }\n  window.print();\n});\n\ndocument.getElementById(\"pdfHoro\").addEventListener(\"click\", ()=>{\n  const el = document.getElementById(\"horoReading\");\n  if(el.classList.contains(\"empty\")){ return; }\n  window.print();\n});\n\nfunction fallbackCopy(texto, cb){\n  const ta = document.createElement(\"textarea\");\n  ta.value = texto;\n  ta.style.position = \"fixed\";\n  ta.style.opacity = \"0\";\n  document.body.appendChild(ta);\n  ta.select();\n  try{ document.execCommand(\"copy\"); }catch(e){}\n  document.body.removeChild(ta);\n  cb();\n}\n</script>\n\n</body>\n</html>\n"}
